# Optional data-provider credentials
TUSHARE_TOKEN=
FRED_API_KEY=
# Required by SEC EDGAR policy: identify your app and provide your own contact.
# Example format only: MyResearchApp/1.0 (me@example.com)
SEC_USER_AGENT=

# NAS 宿主机长期数据目录；可填写“我的文件夹/data”的绝对路径。
FOUNDF_HOST_DATA_DIR=./data
# 宿主机 Python 命令的数据根目录；容器内固定使用 /app/data。
FOUNDF_DATA_ROOT=data
DUCKDB_PATH=data/finance.duckdb

# NAS automation is fail-closed and disabled by default. Start the automation
# profile only after checking the three schedule times and then set true.
FOUNDF_AUTOMATION_ENABLED=false
FOUNDF_COLLECT_AT=17:15
FOUNDF_DAILY_AT=18:15
FOUNDF_REVIEW_AT=18:45
FOUNDF_BACKUP_AT=03:30
# Must own (or have write access to) FOUNDF_HOST_DATA_DIR and ./reports.
FOUNDF_RUNTIME_UID=1000
FOUNDF_RUNTIME_GID=1000

# Optional licensed/discovery sources. All are disabled until explicit
# entitlement and storage permissions are confirmed.
BLOOMBERG_ENABLED=false
BLOOMBERG_ENTITLEMENT_CONFIRMED=false
BLOOMBERG_STORAGE_ALLOWED=false
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# Investing.com: authorized user export only; web scraping is not supported.
INVESTING_EXPORT_LICENSE_CONFIRMED=false

# Brave Search is discovery-only unless the subscribed plan grants storage.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_ALLOWED=false

# Google Custom Search is closed to new customers and sunsets on 2027-01-01.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
GOOGLE_CSE_EXISTING_CUSTOMER=false

# Comma-separated research queries. Search snippets never become facts without
# an official/licensed source and an independent corroborating source.
EXTERNAL_INTELLIGENCE_ENABLED=false
EXTERNAL_INTELLIGENCE_QUERIES=

# End-customer dashboard login. Keep false until all three credential values
# below are configured. Use true only after generating the password hash and
# a random 32+ character secret.
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
DASHBOARD_SECRET_KEY=
DASHBOARD_SESSION_SECONDS=28800

# Set true only when the dashboard is served through HTTPS.
DASHBOARD_COOKIE_SECURE=false

# Comma-separated trusted browser origins; leave empty for same-origin access.
FOUNDF_CORS_ORIGINS=

# Host-only phone integration. Never commit a real path or device serial.
PHONE_CTL_HOME=
FOUNDF_ADB_SERIAL=

# 全球看盘：Yahoo/yfinance 仅限个人研究，延迟未知时不会标记为实时。
MARKET_WATCH_ENABLED=true
MARKET_WATCH_POLL_SECONDS=60
# 自选列表写入还要求 Dashboard 登录和每次显式确认编号。
MARKET_WATCH_MUTATIONS_ENABLED=false
